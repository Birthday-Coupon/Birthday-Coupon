# ==============================================
# מתנת יום הולדת (Birthday Gift IL) - Environment
# ==============================================

# --- Supabase (Required for live production mode) ---
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Keep SECRET! Never expose to browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="מתנת יום הולדת"
# Set to "true" ONLY in local/staging demo when Supabase is not yet connected
NEXT_PUBLIC_ALLOW_DEMO_MODE=true

# --- Email Provider (Resend) ---
# Leave empty to use safe console logging in development
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="מתנת יום הולדת <noreply@yourdomain.co.il>"

# --- Scheduled Jobs (Vercel Cron / GitHub Actions Secret) ---
CRON_SECRET=replace-with-long-random-secret

# --- Observability (Optional - Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
